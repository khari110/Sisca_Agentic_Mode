+.keys-back-btn:hover { background: #fff; color: var(--theme-primary); border-color: var(--theme-primary); }
+@keyframes keysPageIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
+@media (prefers-reduced-motion: reduce) { body.keys-page-open .keys-page { animation: none; } }
 
