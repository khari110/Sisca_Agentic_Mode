+// API Keys ab popup nahi: main screen par page ban kar khulta hai (chat chhup jata hai, "Back to chat" se wapas)
+const apiKeysBtn = document.getElementById('apiKeysBtn');
+const apiKeysPage = document.getElementById('apiKeysPage');
+function isKeysPageOpen() { return document.body.classList.contains('keys-page-open'); }
+function openApiKeysPage() {
+    renderApiKeysPage();
+    document.body.classList.add('keys-page-open');
+    apiKeysBtn.classList.add('current');
+    apiKeysPage.scrollTop = 0;
+    // Mobile par sidebar poori screen dhakta hai: page dikhane ke liye band kar do
+    if (window.innerWidth <= 900) { const x = document.getElementById('closeSidebar'); if (x) x.click(); }
+}
+function closeApiKeysPage() {
+    document.body.classList.remove('keys-page-open');
+    apiKeysBtn.classList.remove('current');
+}
+apiKeysBtn.addEventListener('click', () => { isKeysPageOpen() ? closeApiKeysPage() : openApiKeysPage(); });
+document.getElementById('keysBackBtn').addEventListener('click', closeApiKeysPage);
+document.addEventListener('keydown', (e) => {
+    if (e.key !== 'Escape' || !isKeysPageOpen()) return;
+    if (document.querySelector('.modal[style*="display: flex"]')) return;   // koi popup khula ho to pehle wahi band ho
+    closeApiKeysPage();
+});
